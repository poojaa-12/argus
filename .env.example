# Reliability (existing orchestrator)
ARGUS_MAX_RETRIES=2
ARGUS_BASE_DELAY_S=0.0
ARGUS_JITTER_S=0.0
ARGUS_EVAL_SEED=1337
# ARGUS_DEFAULT_STEP_TIMEOUT_MS=2000
# ARGUS_RUNTIME_CONFIG=./runtime_config.json

# Graph runtime
ARGUS_CONTEXT_WINDOW=8192
ARGUS_COMPRESS_THRESHOLD=0.8
ARGUS_DESTRUCTIVE_TOOLS=db_write,delete_record
ARGUS_LLM_PROVIDER=scripted
ARGUS_LLM_MODEL=gpt-4o-mini
ARGUS_MAX_OPERATOR_ITERS=6

# Serving
ARGUS_REDIS_URL=redis://localhost:6379/0
ARGUS_DATABASE_URL=postgresql://argus:argus@localhost:5434/argus
# ARGUS_DATABASE_URL=sqlite:///./argus.db

# Optional live LLM
# OPENAI_API_KEY=
# ARGUS_LLM_PROVIDER=openai
